<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_quotation_approvers_view_list" model="ir.ui.view">
        <field name="name">sale.quotation.approvers.view.list</field>
        <field name="model">sale.quotation.approvers</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="sale_quotation_approvers_view_form" model="ir.ui.view">
        <field name="name">sale.quotation.approvers.view.form</field>
        <field name="model">sale.quotation.approvers</field>
        <field name="arch" type="xml">
            <form string="Approvers">
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_quotation_approvers" model="ir.actions.act_window">
        <field name="name">Sale Quotation Approvers</field>
        <field name="res_model">sale.quotation.approvers</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sale_quotation_approvers"
              name="Sale Quotation Approvers"
              parent="sale.prod_config_main"
              action="action_sale_quotation_approvers"
              sequence="1"/>
</odoo>
