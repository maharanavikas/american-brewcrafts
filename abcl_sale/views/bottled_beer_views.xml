<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="abcl_bottled_beer_list_view" model="ir.ui.view">
        <field name="name">abcl.bottled.beer.list.view</field>
        <field name="model">bottled.beer</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="true">
                <field name="name"/>
                <field name="uom_id"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="action_abcl_bottled_beer" model="ir.actions.act_window">
        <field name="name">Bottled Beer</field>
        <field name="res_model">bottled.beer</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_abcl_bottled_beer"
              name="Bottled Beer"
              parent="stock.menu_product_in_config_stock"
              action="action_abcl_bottled_beer"
              sequence="10"/>
</odoo>