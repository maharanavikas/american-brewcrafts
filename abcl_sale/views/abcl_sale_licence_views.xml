<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="abcl_sale_licence_list_view" model="ir.ui.view">
        <field name="name">abcl.sale.licence.list.view</field>
        <field name="model">abcl.sale.licence</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="true">
                <field name="name"/>
                <field name="licence_no"/>
            </list>
        </field>
    </record>

    <record id="action_abcl_sale_licence" model="ir.actions.act_window">
        <field name="name">Sale Licence</field>
        <field name="res_model">abcl.sale.licence</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_abcl_sale_licence"
              name="Sales Licence"
              parent="menu_abcl_sale_data_config"
              action="action_abcl_sale_licence"
              sequence="11"/>
</odoo>