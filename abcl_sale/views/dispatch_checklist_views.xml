<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="dispatch_checklist_list_view" model="ir.ui.view">
        <field name="name">dispatch.checklist.list.view</field>
        <field name="model">dispatch.checklist</field>
        <field name="arch" type="xml">
            <list>
                <field name="picking_id"/>
                <field name="customer_id"/>
                <field name="stock_move_id"/>
                <field name="dispatch_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="dispatch_checklist_form_view" model="ir.ui.view">
        <field name="name">dispatch.checklist.form.view</field>
        <field name="model">dispatch.checklist</field>
        <field name="arch" type="xml">
            <form string="Dispatch Checklist">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id" />
                            <field name="picking_id" />
                            <field name="dis_brand" />
                        </group>
                        <group>
                            <field name="dispatch_date" />
                            <field name="deport"/>
                            <field name="vehicle_type"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Gate Pass">
                            <field name="line_ids">
                                <list open_form_view="0" edit="0" create="0" delete="0">
                                    <field name="label" string="Dispatch Parameters" readonly="1"/>
                                    <field name="specifications" string="Specifictions" readonly="1"/>
                                    <field name="remarks" readonly="1"/>
                                    <field name="status" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dispatch_checklist" model="ir.actions.act_window">
        <field name="name">Dispatch Checklist</field>
        <field name="res_model">dispatch.checklist</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
<!--    <menuitem id="menu_dispatch_checklist_config"-->
<!--              name="Dispatch Checklist"-->
<!--              parent="sale.menu_sale_config"-->
<!--              sequence="30">-->

