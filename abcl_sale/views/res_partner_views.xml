<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="abcl_res_partner_view_form" model="ir.ui.view">
        <field name="name">abcl.res.partner.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="product.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='parent_pricelists']" position="after">
                <field name="allowed_products" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="sign_template_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <field name="property_product_pricelist" position="attributes">
                <attribute name="domain">[('status', '=' , 'approved')]</attribute>
            </field>
            <field name="l10n_in_pan" position="after">
                <field name="excise_approver_allias"/>df
            </field>
        </field>
    </record>

