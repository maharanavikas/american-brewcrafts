<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="abcl_alcohol_strength_list_view" model="ir.ui.view">
        <field name="name">abcl.alcohol.strength.list.view</field>
        <field name="model">alcohol.strength</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="true">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_abcl_alcohol_strength" model="ir.actions.act_window">
        <field name="name">Alcohol Strength</field>
        <field name="res_model">alcohol.strength</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_abcl_alcohol_strength"
              name="Alcohol Strength"
              parent="stock.menu_product_in_config_stock"
              action="action_abcl_alcohol_strength"
              sequence="10"/>
</odoo>