<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="stock.action_report_picking" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_view_types"></field>
    </record>

    <template id="abcl_report_delivery_document_inherit" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='div_incoming_address']" position="replace">
            <div class="col-6">
                <h6 class="fw-bold">Supplier (Bill from)</h6>
                <ul class="list-unstyled">
                    <li>
                        <p class="fw-bold"><span t-field="o.move_ids[0].partner_id.name"/></p>
                        <span t-field="o.move_ids[0].partner_id.street"/><br/>
                        <span t-field="o.move_ids[0].partner_id.street2"/><br/>
                        <span t-field="o.move_ids[0].partner_id.city"/><br/>
                        <span t-field="o.move_ids[0].partner_id.state_id"/><br/>
                        <span t-field="o.move_ids[0].partner_id.zip"/><br/>
                        <p>Phone: <span t-field="o.move_ids[0].partner_id.phone"/></p>
                        <span t-if="o.move_ids[0].partner_id.cin_no">
                            CIN: <span t-field="o.move_ids[0].partner_id.cin_no"/><br/>
                        </span>
                        <span t-if="o.move_ids[0].partner_id.vat">
                            GSTIN/UIN: <span t-field="o.move_ids[0].partner_id.vat"/><br/>
                        </span>
                    </li>
                </ul>
            </div>
        </xpath>
        <xpath expr="//div[@name='div_outgoing_address']" position="replace">
            <div class="ms-2">
                <h6 class="fw-bold">Consignee (Ship to)</h6>
                <strong>
                    <p>Lilasons Alcobev Pvt.Ltd.</p>
                </strong>
                <ul class="list-unstyled" name='company_address_list'>
                    <li>
                        <span>Survey No: 238 &amp; 239, Village: Mallepally</span><br/>
                        <span>Mandal: Kondapur, Dist: Sangareddy, Telangana - 502295</span><br/>
                        <span>PAN: AABCL7440D, GSTIN: 36AABCL7440D1ZR, Ph. No: 8099223922</span><br/>
                        <span>Regd Office: 606, Krishika Mansion, Chaitanya Nagar</span><br/>
                        <span>Vivekananda Nagar Colony, Kukatpally, Hyderabad - 500072</span><br/>
                        <span>CIN No: U15600MP2010PTC023192</span><br/>
                        <span>Mail Id: lilasionsalcobevpvtltd@gmail.com</span><br/>
                    </li>
                </ul>
            </div>
        </xpath>
    </template>
    <template id="report_purchaseorder_document_inherited" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-set='address']" position="replace">
            <div class="row py-2">
                <div class="col-6">
                    <h6 class="fw-bold">Supplier (Bill from)</h6>
                    <ul class="list-unstyled" name='company_address_list'>
                        <li>
                            <h4 class="fw-bold"><span t-field="o.partner_id.name"/></h4>
                            <span t-field="o.partner_id.street"/><br/>
                            <span t-field="o.partner_id.street2"/><br/>
                            <span t-field="o.partner_id.city"/><br/>
                            <span t-field="o.partner_id.state_id"/><br/>
                            <span t-field="o.partner_id.zip"/><br/>
                            <p>Phone: <span t-field="o.partner_id.phone"/></p>
                            <span t-if="o.partner_id.cin_no">
                                <span t-field="o.partner_id.cin_no"/><br/>
                            </span>
                            <span t-if="o.partner_id.vat">
                                GSTIN/UIN: <span t-field="o.partner_id.vat"/><br/>
                            </span>
                        </li>
                    </ul>
                </div>
                <div class="col-6">
                    <h6 class="fw-bold">Consignee (Ship to)</h6>
                    <ul class="list-unstyled" name='company_address_list'>
                        <li>
                            <h4 class="fw-bold">Lilasons Alcobev Pvt.Ltd.</h4>
                            <span>Survey No: 238 &amp; 239, Village: Mallepally</span><br/>
                            <span>Mandal: Kondapur, Dist: Sangareddy, Telangana - 502295</span><br/>
                            <span>PAN: AABCL7440D, GSTIN: 36AABCL7440D1ZR, Ph. No: 8099223922</span><br/>
                            <span>Regd Office: 606, Krishika Mansion, Chaitanya Nagar</span><br/>
                            <span>Vivekananda Nagar Colony, Kukatpally, Hyderabad - 500072</span><br/>
                            <span>CIN No: U15600MP2010PTC023192</span><br/>
                            <span>Mail Id: lilasionsalcobevpvtltd@gmail.com</span><br/>
                        </li>
                    </ul>
                </div>
            </div>
        </xpath>
    </template>
</odoo>