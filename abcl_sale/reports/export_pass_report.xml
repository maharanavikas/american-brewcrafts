<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="report_export_pass" model="ir.actions.report">
        <field name="name">Export Pass</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">abcl_sale.export_pass_report</field>
        <field name="report_file">abcl_sale.export_pass_report</field>
        <field name="print_report_name">'Export Pass - %s' % (object.name)</field>
        <field name="binding_model_id" ref="abcl_sale.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="export_pass_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="abcl_sale.export_pass_report_template" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
  </template>

    <template id="export_pass_report_template">
        <t t-call="web.basic_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page" style="font-family: Calibri; font-size: 1px; row-gap: 0px;">
                <div class="text-center">
                    <h2 style="color: black;"><b><u>EXPORT PASS</u></b></h2>
                </div>
                <br/>
                <div>
                    <table class="table table-borderless" style="width: 100%; font-size: 1px; row-gap: 0px; color: black;">
                        <tr>
                            <td><h4 style="color: black;"><b><u>Brewery Transport Permit No.</u> <t t-esc="doc.transport_permit_no"/></b> </h4></td>
                            <td style="padding-right: 150px;"><h4 style="color: black;"><b><u>Date: <t t-esc="" t-options='{"widget": "date"}'/> </u></b></h4></td>
                        </tr>
                    </table>
                </div>
                <div>
                    <table class="table table-borderless" style="width: 100%; font-size: 1px; row-gap: 0px; line-height: 0.5; color: black;">
                        <tr>
                            <td><h4>1</h4></td>
                            <td><h4>Name of the Exporter and Full Address</h4></td>
                            <td><h4>:</h4></td>
                            <td><h4>M/s Liasons Alco Bev Private Limited, Survey No: 238, 239 &amp; 240, Mallepally (V), Kondapur (M), Sangareddy District, Telangana State, PIN Code- 502 295.</h4></td>
                        </tr>
                        <tr>
                            <td><h4>2</h4></td>
                            <td><h4>Details of License held by him</h4></td>
                            <td><h4>:</h4></td>
                            <td><h4><t t-esc="doc.company_id.license_details"/></h4></td>
                        </tr>
                        <tr>
                            <td><h4>3</h4></td>
                            <td><h4>Authority of the order of export permit under which the pass is issued</h4></td>
                            <td><h4>:</h4></td>
                            <td><h4>Commissioner of Prohibition and Excise, Hyderabad of Telangana State Export Permit NO : <b><t t-esc="doc.export_permit_id.display_name"/></b></h4></td>
                        </tr>
                        <tr>
                            <td><h4>4</h4></td>
                            <td><h4>Place of Dispatch with Date &amp; Time</h4></td>
                            <td><h4>:</h4></td>
                            <td><h4>Mallepally (V), Kondapur (M), Sangareddy District of Telangana State. Dt:- <b><t t-esc="doc.e_pass_dispatch_date_time"/></b></h4></td>
                        </tr>
                        <tr>
                            <td><h4>5</h4></td>
                            <td><h4>Place of Destination</h4></td>
                            <td><h4>:</h4></td>
                            <td><h4><t t-esc="doc.partner_id.name"/>, <t t-esc="doc.partner_id.city"/>, <t t-esc="doc.partner_id.state_id.name"/></h4></td>
                        </tr>
                        <tr>
                            <td><h4>6</h4></td>
                            <td><h4>Prohibition time and date of arrival of Consignment to the Destination</h4></td>
                            <td><h4>:</h4></td>
                            <td><h4>() days.</h4></td>
                        </tr>
                        <tr>
                            <td><h4>7</h4></td>
                            <td><h4>Quantity and quality of (Indian Liquor)/Beer issued in Liters (details of)</h4></td>
                            <td><h4>:</h4></td>
                            <td><h4>Total : (<t t-esc="int(doc.total_qty)"/>) in (<t t-esc="int(doc.total_bulk_liter)"/>) in Bls</h4><br/>
                                <t t-foreach="doc.move_ids" t-as="product">
                                    <t t-set="idx" t-value="product_index + 1"/>
                                    <h4> <t t-esc="idx"/>) <t t-esc="int(product.quantity)"/> <t t-esc="product.product_uom.alias"/> <t t-esc="product.product_id.name"/></h4>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td><h4>8</h4></td>
                            <td><h4>Strength Make, Company's Name</h4></td>
                            <td><h4>:</h4></td>
                            <td><h4></h4></td>
                        </tr>
                        <tr>
                            <td><h4>9</h4></td>
                            <td><h4>Route To Be Followed</h4></td>
                            <td><h4>:</h4></td>
                            <td><h4><t t-esc="doc.delivery_route"/></h4></td>
                        </tr>
                        <tr>
                            <td><h4>10</h4></td>
                            <td><h4>Period of validity of the pass</h4></td>
                            <td><h4>:</h4></td>
                            <td><h4><b>From: </b></h4></td>
                        </tr>
                    </table>
                </div>
            </div>    
        </t>
    </template>
</odoo>    