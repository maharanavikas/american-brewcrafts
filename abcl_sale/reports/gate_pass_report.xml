<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_gate_pass_report" model="ir.actions.report">
        <field name="name">Gate Pass</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <!-- <field name="report_type">qweb-html</field> -->
        <field name="report_name">abcl_sale.gate_pass_template</field>
        <field name="report_file">abcl_sale.gate_pass_template</field>
        <field name="print_report_name">'Gate Pass - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="gate_pass_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <main>
                            <div style="border:3px solid #000; border-radius:16px; padding:28px 34px; height:940px; font-family:Arial; font-size:13pt; position:relative;">

                                <!-- COMPANY NAME -->
                                <div style="text-align:center; font-weight:900; font-size:24pt; letter-spacing:1px; margin-bottom:10px;">
                                    LILASONS ALCO BEV PVT. LTD.
                                </div>

                                <!-- HEADER -->
                                <table style="width:100%; margin:10px 0 25px;" class="table table-borderless">
                                    <tr>
                                        <td style="width:25%; text-align:left;">
                                            <img src="/abcl_sale/static/src/img/lilasons_logo.png"
                                                 style="max-width: 150px; height: 100px;"/>
                                        </td>
                                        <td style="width:50%; text-align:center;">
                                            <span style="background:#000; color:#fff; padding:8px 45px; font-size:20pt; font-weight:900; border-radius:40px;">
                                                GATE PASS
                                            </span>
                                        </td>
                                        <td style="width:25%;"></td>
                                    </tr>
                                </table>

                                <!-- T.P. No & Date -->
                                <table style="width:100%; font-size:13pt; margin-bottom:20px; margin-left: -5px;"
                                       class="table table-borderless">
                                    <tr>
                                        <td style="width:55%; white-space:nowrap;">
                                            <strong>T.P. No.</strong>
                                            <span style="padding-left:20px; display:inline-block; width:300px;">
                                                <t t-esc="o.transport_permit_no or ''"/>
                                            </span>
                                        </td>
                                        <td style="text-align:right;">
                                            <strong>Date</strong>
                                            <span style="padding-left:20px; display:inline-block; width:180px; border-bottom:1.6px solid #000; text-align:left;">
                                                <t t-esc="o.scheduled_date.strftime('%d/%m/%Y')"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>

                                <!-- PARTY NAME -->
                                <div style="margin:20px 0; font-size:14pt;">
                                    <strong>Name of the party</strong>
                                    <span style="margin-left:15px; display:inline-block; width:75%; border-bottom:1.6px solid #000; padding:3px 6px;">
                                        <t t-esc="o.partner_id.name or ''"/>
                                    </span>
                                </div>

                                <!-- PACK + QTY DISPLAY -->
                                <t t-set="bottled_beer" t-value="o.move_ids_without_package.product_id.bottled_beer_id"/>

                                <table style="width:100%; font-size:14pt; margin:18px 0 18px 0; border-collapse:collapse; margin-left: -5px;" class="table table-borderless">
                                    <tr>
                                        <td style="width:110px; font-weight:600; padding:3px 6px;">BOTTLED BEER</td>
                                        <td style="width:150px; border-bottom:1.6px solid #000; padding:3px 6px;"
                                            t-out="', '.join(bottled_beer.mapped('name')) if bottled_beer else ''"/>

                                        <td style="width:110px; text-align:center; font-weight:600; padding:3px 6px;">
                                            Qts.Doz
                                        </td>
                                        <td style="width:150px; border-bottom:1.6px solid #000; padding:3px 6px;">
                                            <t t-esc="', '.join(o.move_ids_without_package.mapped(lambda r: str(r.product_uom_qty))) if o.move_ids_without_package else ''"/>
                                        </td>
                                    </tr>
                                </table>

                                <div style="font-size:14pt; margin:18px 0; display:flex; align-items:flex-start;">
                                    <strong style="white-space:nowrap; margin-right:15px;">Brand</strong>
                                    <span style="display:inline-block; width:90%; border-bottom:1.6px solid #000; padding:3px 6px; min-height:24px; white-space:normal; word-wrap:break-word;">
                                        <t t-esc="', '.join(o.move_ids_without_package.product_id.mapped('name')) if o.move_ids_without_package else ''"/>
                                    </span>
                                </div>
                                <!-- VEHICLE NO -->
                                <div style="margin:18px 0; font-size:14pt;">
                                    <strong>Vehicle No.</strong>
                                    <span style="margin-left:15px; display:inline-block; width:85%; border-bottom:1.6px solid #000; padding:3px 6px;">
                                        <t t-esc="o.vehicle_no or ''"/>
                                    </span>
                                </div>

                                <!-- DATE AGAIN -->
                                <div style="margin:12px 0; font-size:14pt;">
                                    <strong>Date</strong>
                                    <span style="margin-left:20px; display:inline-block; width:85%; border-bottom:1.6px solid #000;">
                                        <t t-esc="o.scheduled_date.strftime('%d/%m/%Y')"/>
                                    </span>
                                </div>

                                <div style="position:absolute; bottom:50px; left:34px; right:34px;">

                                    <div style="font-size:16pt; font-weight:900; margin-bottom:50px;">
                                        For LILASONS ALCO BEV PVT. LIMITED
                                    </div>

                                    <div style="font-size:15pt; font-weight:900; margin-bottom:25px;">
                                        Authorised Signatory
                                    </div>

                                    <div style="float:right; width:45%; margin-top:10px; text-align:center; font-size:11pt; line-height:1.35;">
                                        <strong style="font-size:14pt;">BREWERY OFFICER</strong>
                                        <br/>
                                        M/s. LILASONS ALCO BEV PVT. LIMITED
                                        <br/>
                                        Survey # 238, (V) Mallepally, (M) Kondapur,
                                        <br/>
                                        Sangareddy Dist. - T.S. - 502 295.
                                    </div>

                                </div>

                            </div>
                        </main>
                    </div>
                </t>
            </t>
        </t>
    </template>


</odoo>