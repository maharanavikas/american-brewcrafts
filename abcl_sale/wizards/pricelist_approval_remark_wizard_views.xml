<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_approval_remark_wizard_form" model="ir.ui.view">
        <field name="name">pricelist.approval.remark.wizard.form</field>
        <field name="model">pricelist.approval.remark.wizard</field>
        <field name="arch" type="xml">
            <form string="Enter Remark">
                <group>
                    <field name="status" invisible='1'/>
                    <field name="pricelist_id" invisible="1"/>
                    <field name="remark"/>
                </group>
                <footer>
                    <button string="Submit" name="apply_remark" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>