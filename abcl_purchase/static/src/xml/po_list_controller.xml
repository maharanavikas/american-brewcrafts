<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="custom_po_list.ListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <button t-if="props.resModel == 'purchase.order'"
                    class="btn btn-primary"
                    t-on-click="generateDraftPO">
                Create Draft PO
            </button>
        </xpath>
    </t>
</templates>
