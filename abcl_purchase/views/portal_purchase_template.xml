<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_my_home_inherit_purchase_orders" inherit_id="portal.portal_my_home"
              name="Portal My Home: Purchase Order List">
        <xpath expr="//div[@id='portal_client_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/abcl_purchase/static/src/img/purchase_portal.svg'"/>
                <t t-set="title">Purchase Orders</t>
                <t t-set="text">View your purchase orders</t>
                <t t-set="url" t-value="'/purchase_order_list/'"/>
                <!--                <t t-set="config_card" t-value="True"/>-->
                <t t-set="config_card" t-value="request.env.user.sudo().employee_ids"/>
            </t>

        </xpath>
    </template>

    <template id="portal_breadcrumbs_purchase_orders" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'purchase_orders'" class="breadcrumb-item active">
                Purchase Orders
            </li>

            <t t-if="page_name == 'purchase_order_form' and record">
                <li class="breadcrumb-item">
                    <a href="/purchase_order_list/">Purchase Orders</a>
                </li>
                <li class="breadcrumb-item active" t-out="record.name"/>
            </t>
            <t t-if="page_name == 'create_purchase_orders'">
                <li class="breadcrumb-item">
                    <a href="/purchase_order_list/">Purchase Orders</a>
                </li>
                <li class="breadcrumb-item active">
                    New Purchase Order
                </li>
            </t>
        </xpath>
    </template>

    <template id="purchase_order_list_template" name="Purchase Order List">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'purchase_orders'"/>
            <div class="container my-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2>Purchase Orders</h2>
                    <a href="/purchase_order/new" class="btn btn-primary">Create Purchase Order</a>
                </div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>PO Number</th>
                            <th>Category</th>
                            <th>Vendor</th>
                            <th>Expected Arrival</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="purchase_orders" t-as="po">
                            <tr>
                                <td>
                                    <a t-att-href="'/purchase_order/%d' % po.id" class="link-primary">
                                        <t t-out="po.name"/>
                                    </a>
                                </td>
                                <td t-out="po.product_categ_id and po.product_categ_id.name or ''">

                                </td>
                                <td>
                                    <t t-out="po.partner_id.name"/>
                                </td>
                                <td>
                                    <t t-out="po.date_approve and po.date_approve.strftime('%Y-%m-%d') or '-'"/>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">
                                        <t t-out="po.state"/>
                                    </span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="purchase_order_create_template" name="Create Purchase Order">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'purchase_order_form'"/>
            <t t-set="po_readonly" t-value="record and (record.state in ['purchase', 'done'] or record.sent_for_approval)"/>
            <div class="container my-4">
                <h3 t-if="not record">Create PO</h3>
                <form id="purchase_order_form" t-attf-action="/purchase_order/#{'new' if not record else record.id}"
                      method="post" t-att-data-id="record and record.id">
                    <div t-if="success_message" class="alert alert-success" role="alert" t-out="success_message"/>

                    <t t-if="record and not record.approval_line_ids">
                        <button type="button" id="send-for-approval-btn" class="btn btn-warning me-2"
                                t-att-data-id="record.id" t-if="record.state == 'draft'">
                            Send for Approval
                        </button>
                    </t>

                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="d-flex justify-content-between align-items-center mb-3" t-if="record">
                        <h3 t-out="record.name"/>

                        <span t-att-class="'badge rounded-pill px-3 py-2 ' + (
                                    'bg-success' if record.state == 'purchase' else (
                                    'bg-secondary' if record.state == 'done' else 'bg-warning'))">
                            <t t-out="record.state.capitalize()"/>
                        </span>
                    </div>

                    <!-- Tabs -->
                    <ul class="nav nav-tabs" id="poTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <!--                                                <a class="nav-link active fw-bold" id="order-lines-tab" data-bs-toggle="tab"-->
                            <!--                                                   href="#order-lines" role="tab">Order Lines-->
                            <!--                                                </a>-->
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content border border-top-0 p-3" id="poTabContent">

                        <div class="tab-pane fade show active" id="order-lines" role="tabpanel">
                            <div class="card bg-white mb-2">
                                <div class="card-header bg-white d-none d-sm-block">
                                    <div class="row text-center">
                                        <div class="col-sm-4 fs-6 fw-bold">
                                            <i class="text-danger">*</i>Product
                                        </div>
                                        <div class="col-sm-5 fs-6 fw-bold">
                                            <i class="text-danger">*</i>Quantity
                                        </div>
                                        <div class="col-sm-2 fs-6 fw-bold text-start">
                                            UoM
                                        </div>
                                    </div>
                                </div>
                                <div id="order_line_body" class="card-body">
                                    <t t-set="valid_order_lines"
                                       t-value="record and record.order_line.filtered(lambda r:not r.display_type)"/>
                                    <t t-set="vendor_product_ids"
                                       t-value="(vendor_data and record and (list(filter(lambda product: any(v['partner_id'] == record.partner_id.id for v in product['vendors']), vendor_data))[:1] or [{}])[0])"/>
                                    <div class="order-line row mb-2" t-if="not valid_order_lines">
                                        <div class="col-sm-6">
                                            <label class="d-block d-sm-none fw-bold">Product</label>
                                            <select class="form-select product-select" name="product_id_1" required="1">
                                                <option value="">Select Product</option>
                                            </select>
                                        </div>
                                        <div class="col-sm-3">
                                            <label class="d-block d-sm-none fw-bold">Quantity</label>
                                            <input type="number" name="product_qty_1" min="1" value="1"
                                                   class="form-control" required="1"/>
                                        </div>
                                        <div class="col-sm-2">
                                            <label class="d-block d-sm-none fw-bold">UoM</label>
                                            <span name="uom_id_1"/>
                                        </div>
                                        <hr class="d-block d-sm-none border-1 border-dark mt-2"/>
                                    </div>
                                    <div class="order-line row mb-2" t-else="" t-foreach="valid_order_lines"
                                         t-as="order_line">
                                        <div class="col-sm-6">
                                            <label class="d-block d-sm-none fw-bold">Product</label>
                                            <select class="form-select product-select"
                                                    t-attf-name="product_id_#{order_line_index+1}" required="1"
                                                    t-att-disabled="po_readonly">

                                                <option t-if="order_line.product_id"
                                                        t-att-value="order_line.product_id.id" t-att-selected="True"
                                                        t-out="order_line.product_id.display_name"/>

                                                <t t-foreach="vendor_product_ids.get('product_ids', [])" t-as="product">
                                                    <option t-att-value="product['product_id']"
                                                            t-out="product['name']"
                                                            t-att-selected="order_line.product_id.id == product['product_id']"/>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-sm-3">
                                            <label class="d-block d-sm-none fw-bold">Quantity</label>
                                            <input type="number" t-attf-name="product_qty_#{order_line_index+1}" min="1"
                                                   value="1"
                                                   class="form-control" required="1"
                                                   t-att-value="order_line.product_qty" t-att-disabled="po_readonly"/>
                                        </div>
                                        <div class="col-sm-2">
                                            <label class="d-block d-sm-none fw-bold">UoM</label>
                                            <span t-attf-name="uom_id_#{order_line_index+1}"
                                                  t-out="order_line.product_uom.name"/>
                                        </div>
                                        <hr class="d-block d-sm-none border-1 border-dark mt-2"/>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <br/>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label class="fw-bold">Purchase Category:</label>
                                <select name="product_category_id" id="product_category" class="form-control"
                                        required="required"
                                        t-att-disabled="po_readonly">
                                    <option value="">Select a Category</option>
                                    <t t-if="category_data" t-foreach="category_data" t-as="categ">
                                        <option t-att-value="categ['id']" t-out="categ['name']"
                                                t-att-selected="record and record.product_categ_id.id == categ['id'] and True or False"/>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-2">
                                <label class="fw-bold">Vendor:</label>
                                <select name="partner_id" id="vendor_select" class="form-control" required="required"
                                        t-att-disabled="po_readonly">
                                    <option value="">Select a vendor</option>
                                    <t t-if="vendor_data" t-foreach="vendor_data" t-as="product">
                                        <t t-foreach="product['vendors']" t-as="vendor">
                                            <option t-att-value="vendor['partner_id']" t-out="vendor['partner_name']"
                                                    t-att-selected="record and record.partner_id.id == vendor['partner_id'] and True or False"/>
                                        </t>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-2">
                                <label class="fw-bold">Notes</label>
                                <input type="text" t-att-disabled="po_readonly" name="reason" class="form-control"
                                       placeholder="Reason for PO" t-att-value="record and record.reason"/>
                            </div>
                        </div>
                    </div>

                    <div class="text-end mt-4" t-if="not po_readonly">
                        <button type="submit" class="btn btn-primary fw-bold">
                            <span t-out="'Create Purchase Order' if not record else 'Save'"/>
                        </button>
                    </div>
                </form>
            </div>
        </t>
    </template>

</odoo>
