<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="abcl_purchase_product_template_view_form" model="ir.ui.view">
        <field name="name">abcl.purchaseproduct.template.view.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="supplier_taxes_id" position="before">
                <field name="minimum_qty"/>
                <!--                <field name="manufacturing_date"/>-->
            </field>
        </field>
    </record>
    <record id="abcl_view_product_form_expiry" model="ir.ui.view">
        <field name="name">abcl.product.template.inherit.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <group name="traceability" position="inside">
                <field name="manufacturing_date"/>
            </group>
        </field>
    </record>

    <record id="abcl_product_template_replenish_inherit_form" model="ir.ui.view">
        <field name="name">abcl.product.template.replenish.inherit.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(stock.action_product_replenish)d']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>