    <menuitem id="menu_purchase_mps"
              name="MPS"
              parent="purchase.menu_purchase_root"
              action="action_purchase_mps"
              sequence="30"/>

    <menuitem id="menu_product_purchase_nalysis"
              name="Product Purchase Analysis"
              parent="purchase.purchase_report_main"
