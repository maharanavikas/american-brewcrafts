<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="abcl_product_supplierinfo_view_list" model="ir.ui.view">
        <field name="name">abcl.product.supplierinfo.view.list</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='price']" position="before">
                <field name="minimum_order_qty"/>
            </xpath>
        </field>
    </record>

    <record id="abcl_product_supplierinfo_view_form" model="ir.ui.view">
        <field name="name">abcl.product.supplierinfo.view.form</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='discount']" position="before">
                <field name="minimum_order_qty"/>
            </xpath>
            <xpath expr="//div[field[@name='delay']]" position="after">
                <field name="is_approval_requested" readonly="1" invisible="requested_price &lt;= 0"/>
                <field name="active" readonly="1" invisible="active"/>
                <field name="approver_comment" readonly="1" invisible="not active"/>
            </xpath>
            <xpath expr="//div[@class='o_row'][field[@name='price']]" position="after">
                <field name="requested_price" readonly="1" invisible="requested_price &lt;= 0"/>
                <field name="requested_by" readonly="1" invisible="not is_approval_requested or not is_new_request"/>
                <field name="is_new_request" readonly="1" invisible="active"/>
            </xpath>
            <xpath expr="//label[@for='date_start']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[field[@name='date_start']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='price']" position="attributes">
                <attribute name="readonly">active</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_for_request"
                            string="Request For Approval"
                            type="object"
                            class="btn-primary" invisible="active == True or is_new_request == True"/>
                    <button name="action_approve_wizard"
                            string="Approve"
                            type="object"
                            class="btn-primary" invisible="not is_approval_requested"
                            groups="abcl_base.group_vice_president"/>
                    <button name="action_reject_wizard"
                            string="Reject"
                            type="object"
                            class="btn-secondary" invisible="not is_approval_requested"
                            groups="abcl_base.group_vice_president"/>
                </header>
            </xpath>
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>

    <record id="abcl_product_supplierinfo_search_view" model="ir.ui.view">
        <field name="name">abcl.product.supplierinfo.search.view</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='active']" position="after">
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <separator />
            </xpath>
        </field>
    </record>
</odoo>
