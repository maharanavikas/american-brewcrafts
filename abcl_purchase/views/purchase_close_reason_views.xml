<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_close_reason_view_list" model="ir.ui.view">
        <field name="name">purchase.close.reason.view.list</field>
        <field name="model">purchase.close.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="true">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_purchase_close_reason" model="ir.actions.act_window">
        <field name="name">Purchase Close Reasons</field>
        <field name="res_model">purchase.close.reason</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add reasons used to close purchase orders.
            </p>
        </field>
    </record>
    <menuitem id="menu_purchase_close_reason_root"
              name="Close Reasons"
              parent="purchase.menu_purchase_config"
              action="action_purchase_close_reason"
              sequence="50"/>
</odoo>
