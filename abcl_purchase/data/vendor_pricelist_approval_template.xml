<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="abcl_vendor_pricelist_approval_mail_template" model="mail.template">
            <field name="name">Vendor Pricelist: Approval Request</field>
            <field name="model_id" ref="product.model_product_supplierinfo"/>
            <field name="subject">Approval Required: Vendor Pricelist for {{ object.partner_id.name }}</field>
            <field name="email_from">{{ object.company_id.email_formatted or '' }}</field>
            <field name="email_to">{{ '' }}</field>
            <field name="description">Sent to the approver when the Vendor Pricelist requires approval</field>
            <field name="body_html" type="html">
                <t t-set="product" t-value="object.product_id or object.product_tmpl_id"/>
                <t t-set="pricelist" t-value="object"/>
                <t t-set="approval_log" t-value="ctx.get('approval_log')"/>
                <table>
                    <tbody>
                        <!-- HEADER -->
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="590"
                                       style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                    <tr>
                                        <td valign="middle">
                                            <p style="font-size: 14px;font-weight:bold;">Vendor Pricelist Approval</p>
                                        </td>
                                        <td valign="middle" align="right">
                                            <img t-attf-src="/logo.png?company={{ pricelist.company_id.id }}"
                                                style="padding: 0px; margin: 0px; height: auto; width: 80px;"
                                                t-att-alt="pricelist.company_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" style="text-align:center;">
                                            <hr width="100%"
                                                style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- CONTENT -->
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="590"
                                       style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                    <tr>
                                        <td valign="top" style="font-size: 13px;">
                                            <div>
                                                Hi <strong t-out="ctx.get('approver_name', '')"/>,
                                                <p>
                                                    A vendor pricelist for product
                                                    <strong t-out="product.name"/>
                                                    of vendor <strong t-out="pricelist.partner_id.name"/> <span t-if="approval_log and approval_log.is_initial" t-out="'has been initialized and '"/>
                                                    requires your approval.
                                                </p>

                                                <p t-if="approval_log and not approval_log.is_initial">
                                                    Old Price:
                                                    <span t-out="approval_log.old_price"/>
                                                </p>
                                                <p t-if="approval_log">
                                                    <span t-if="approval_log.is_initial" t-out="'Requested Price'"/> <span t-else="" t-out="'New Price'"/>:
                                                    <span t-out="approval_log.new_price"/>
                                                </p>
                                                <p>
                                                    Please review and take necessary action.
                                                </p>
                                                <p>
                                                    Regards,
                                                    <br/>
                                                    <span t-out="pricelist.company_id.name"/>
                                                </p>
                                            </div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="text-align:center;">
                                            <hr width="100%"
                                                style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- FOOTER -->
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="590"
                                       style="min-width: 590px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                    <tr>
                                        <td valign="middle" align="left" style="opacity: 0.7;">
                                            <t t-out="pricelist.company_id.phone or ''"/>
                                            <t t-if="pricelist.company_id.email">
                                                |
                                                <a t-att-href="'mailto:%s' % pricelist.company_id.email"
                                                   style="text-decoration:none; color: #454748;">
                                                    <t t-out="pricelist.company_id.email or ''"/>
                                                </a>
                                            </t>
                                            <t t-if="pricelist.company_id.website">
                                                |
                                                <a t-att-href="'%s' % pricelist.company_id.website"
                                                   style="text-decoration:none; color: #454748;">
                                                    <t t-out="pricelist.company_id.website or ''"/>
                                                </a>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </field>
        </record>

    </data>
</odoo>
