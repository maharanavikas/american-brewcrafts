<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_close_wizard_form" model="ir.ui.view">
    <field name="name">purchase.close.reason.wizard.form</field>
    <field name="model">purchase.close.reason.wizard</field>
    <field name="arch" type="xml">
        <form string="Close Purchase Order">
            <group>
                <field name="purchase_id" invisible="1"/>
                <field name="close_reason_id"/>
            </group>
            <footer>
                <button string="Close Purchase" type="object" name="action_confirm_close" class="btn-primary"/>
                <button string="Cancel" special="cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>
</odoo>