<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="vendor_pricelist_approval_wizard_form" model="ir.ui.view">
    <field name="name">vendor.pricelist.approval.wizard.form</field>
    <field name="model">vendor.pricelist.approval.wizard</field>
    <field name="arch" type="xml">
        <form string="Vendor Pricelist Approval">
            <group>
                <field name="comment"/>
            </group>
            <footer>
                <button string="Submit" type="object" name="action_submit" class="btn-primary"/>
                <button string="Cancel" special="cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>
</odoo>