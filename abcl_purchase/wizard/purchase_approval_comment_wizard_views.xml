<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_approval_comment_wizard_view_form" model="ir.ui.view">
    <field name="name">purchase.approval.comment.wizard.view.form</field>
    <field name="model">purchase.approval.comment.wizard</field>
    <field name="arch" type="xml">
        <form string="Approve Purchase Order">
            <group>
                <field name="action_type" invisible="1"/>
                <field name="purchase_id" invisible="1"/>
                <field name="comment"/>
            </group>
            <footer>
                <button name="action_submit" type="object" string="Submit" class="btn-primary"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
</odoo>