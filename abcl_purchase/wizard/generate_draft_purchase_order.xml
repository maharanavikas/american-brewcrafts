<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_generate_draft_po_wizard" model="ir.ui.view">
        <field name="name">generate.draft.po.wizard.form</field>
        <field name="model">generate.draft.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Draft Purchase Order">
                <group>
                    <field name="product_id"/>
                    <field name="categ_id" readonly="1"/>
                    <field name="supplierinfo_ids" readonly="1">
                        <list>
                            <field name="partner_id"/>
                            <field name="price"/>
                            <field name="delay"/>
                        </list>
                    </field>
                    <field name="vendor_id" can_create="True"/>
                    <!-- <field name="unit_price" readonly="1"/> -->
                    <field name="allowed_vendor_ids" widget="many2many_tags" invisible="1"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_generate_po" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_draft_po_wizard" model="ir.actions.act_window">
        <field name="name">Generate Draft PO</field>
        <field name="res_model">generate.draft.po.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="abcl_purchase.view_generate_draft_po_wizard"/>
        <field name="target">new</field>
    </record>

</odoo>
