<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_alternative_vendor_wizard_form" model="ir.ui.view">
        <field name="name">alternative.vendor.wizard.form</field>
        <field name="model">alternative.vendor.wizard</field>
        <field name="arch" type="xml">
            <form string="Alternative Vendors">
                <sheet>
                    <group>
                        <field name="purchase_order" readonly="1" invisible="1"/>
                        <field name="vendor_info">
                            <list>
                                <field name="partner_id"/>
                                <field name="product_id"/>
                                <field name="price"/>
                                <field name="min_qty"/>
                            </list>
                        </field>
                        <field name="alternative_vendor" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>