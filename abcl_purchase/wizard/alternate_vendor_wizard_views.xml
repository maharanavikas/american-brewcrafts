<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_alternative_vendor_wizard_form" model="ir.ui.view">
        <field name="name">alternative.vendor.wizard.form</field>
        <field name="model">alternative.vendor.wizard</field>
        <field name="arch" type="xml">
            <form string="Alternative Vendors">
                <sheet>
                    <group>
                        <field name="purchase_order" readonly="1" invisible="1"/>
                        <field name="line_ids"
                               widget="sol_o2m">
                            <list 
                                editable="bottom"
                                create='false'
                                delete="false">
                                <field name="order_line_id" column_invisible="1" force_save="1"/>
                                <field name="product_id" force_save="1"/>
                                <field name="vendor_ids" widget="many2many_tags" readonly="1"/>
                            </list>
                        </field>
                        <field name="alternative_vendor"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>