<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="hide_buyer_in_purchase_report"
              inherit_id="purchase.report_purchaseorder_document"
              name="Hide Buyer from Purchase Report">

        <!-- Hide the Buyer column -->
        <xpath expr="//div[@class='col'][strong='Buyer']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

    </template>
</odoo>