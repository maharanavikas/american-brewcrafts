<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_extra_production_wizard_form" model="ir.ui.view">
        <field name="name">extra.production.wizard.form</field>
        <field name="model">extra.production.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Extra Production">
                <group>
                    <field name="production_id" readonly="1"/>
                    <field name="product_id" readonly="1"/>
                    <field name="lot_id"/>
                    <field name="location_id" readonly="1"/>
                    <field name="extra_production"/>
                </group>
                <footer>
                    <button string="Update Quantity" type="object" name="action_apply_extra_production"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>