<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mrp_workcenter_tag_list" model="ir.ui.view">
        <field name="name">mrp.workcenter.tag.list</field>
        <field name="model">mrp.workcenter.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_workcenter_tag_form" model="ir.ui.view">
        <field name="name">mrp.workcenter.tag.form</field>
        <field name="model">mrp.workcenter.tag</field>
        <field name="arch" type="xml">
            <form string="Workcenter Category">
                <sheet>
                    <group>
                        <field name="name" string="Category Name"/>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrp_workcenter_tag" model="ir.actions.act_window">
        <field name="name">Workcenter Categories</field>
        <field name="res_model">mrp.workcenter.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mrp_workcenter_tag" name="Workcenter Categories" parent="mrp.menu_mrp_configuration" action="action_mrp_workcenter_tag" sequence="30"/>

    <record id="mrp_workcenter_dashboard_list_view" model="ir.ui.view">
        <field name="name">mrp.workcenter.dashboard.list.view</field>
        <field name="model">mrp.workcenter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="code" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'no_create': True, 'color_field': 'color'}" optional="show"/>
                <field name="default_capacity" optional="show"/>
                <field name="current_running_qty" optional="show"/>
                <field name="capacity_remaining" optional="show"/>
            </list>
        </field>
    </record>

    <record id="mrp.mrp_workcenter_kanban_action" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('mrp.mrp_workcenter_kanban'), 'sequence': 1}),
                (0, 0, {'view_mode': 'list', 'view_id': ref('mrp_workcenter_dashboard_list_view'), 'sequence': 2}),
            ]"/>
    </record>

</odoo>