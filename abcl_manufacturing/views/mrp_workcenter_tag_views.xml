<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mrp_workcenter_tag_list" model="ir.ui.view">
        <field name="name">mrp.workcenter.tag.list</field>
        <field name="model">mrp.workcenter.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_workcenter_tag_form" model="ir.ui.view">
        <field name="name">mrp.workcenter.tag.form</field>
        <field name="model">mrp.workcenter.tag</field>
        <field name="arch" type="xml">
            <form string="Workcenter Category">
                <sheet>
                    <group>
                        <field name="name" string="Category Name"/>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrp_workcenter_tag" model="ir.actions.act_window">
        <field name="name">Workcenter Categories</field>
        <field name="res_model">mrp.workcenter.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mrp_workcenter_tag"
          name="Workcenter Categories"
          parent="mrp.menu_mrp_configuration"
          action="action_mrp_workcenter_tag"
          sequence="30"/>


</odoo>