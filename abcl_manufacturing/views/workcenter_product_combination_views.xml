<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_workcenter_product_combination_list" model="ir.ui.view">
        <field name="name">workcenter.product.combination.list</field>
        <field name="model">workcenter.product.combination</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="workcenter_category_id"/>
                <field name="product_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_workcenter_product_combination_form" model="ir.ui.view">
        <field name="name">workcenter.product.combination.form</field>
        <field name="model">workcenter.product.combination</field>
        <field name="arch" type="xml">
            <form string="Workcenter Product Combination">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="workcenter_category_id"/>
                    </group>

                    <group>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_workcenter_product_combination" model="ir.actions.act_window">
        <field name="name">Workcenter Product Combinations</field>
        <field name="res_model">workcenter.product.combination</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_workcenter_product_combination"
              name="Workcenter Product Combinations"
              parent="mrp.menu_mrp_configuration"
              action="action_workcenter_product_combination"
              sequence="40"/>


</odoo>