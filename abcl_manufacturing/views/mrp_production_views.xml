<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="abcl_manufacturing_mrp_production_form_view" model="ir.ui.view">
        <field name="name">abcl.manufacturing.mrp.production.form.view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']/field[@name='workorder_ids']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_generate_component_lot_qc"
                type="object"
                string="Generate Component Lot QC"
                class="oe_highlight" invisible="not show_lot_ids or not origin"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='quantity']" position="after">
                <field name="bom_uom_qty" readonly="1" force_save="1" optional="hide"/>
                <field name="qty_difference" readonly="1" force_save="1" optional="hide"/>
                <field name="deviation_percentage" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='location_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="production_source"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_categ_id"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']//field[@name='lot_ids']" position="after">
                <!--                <field name="should_consume_qty"/>-->
                <button name="action_view_lots" string="View Lots" type="object"
                        column_invisible="not parent.show_lot_ids or parent.state == 'draft'" optional="hide"
                        invisible="not show_details_visible" groups="stock.group_production_lot"/>
            </xpath>
            <field name="lot_producing_id" position="attributes">
                <attribute name="context">{
                    'default_product_id': product_id,'active_model':
                    'mrp.production','active_id': id
                    }
                </attribute>
            </field>
            <button name="action_update_bom" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <field name="user_id" position="after">

                <div style="display: flex; align-items: center; width: 100%;">
                    <span class="o_form_label" style="flex: 0 0 20%; max-width: 20%; margin-right: 8px;">
                        <strong>
                            <field name="brew_label" readonly="1" nolabel="1" widget="char"/>
                        </strong>
                    </span>
                    <field name="brew_number" nolabel="1" style="flex: 0 0 80%; max-width: 80%;"/>
                </div>
            </field>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="quantity_available" readonly="1" invisible="state != 'done'"/>
            </xpath>
           <xpath expr="//div[field[@name='lot_producing_id']]" position="after">
                <div class="o_row align-items-center" name="extra_production_div" invisible="state != 'done'">
                    <label for="extra_production" string="Extra Production" class="me-2"/>
                    <field name="extra_production" widget="float" class="me-3"/>
                    <button name="action_update_extra_quantity"
                            string="Update Quantity"
                            type="object"
                            class="btn btn-primary"
                            icon="fa-refresh"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="ancl_manufacturing_mrp_production_tree_view" model="ir.ui.view">
        <field name="name">abcl.manufacturing.mrp.production.tree.view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="before">
                <field name="quantity_available" invisible="state != 'done'"/>
                <field name="extra_production" invisible="state != 'done'"/>
            </xpath>
        </field>
    </record>

    <record id="abcl_manufacturing_mrp_production_search_view" model="ir.ui.view">
        <field name="name">abcl.manufacturing.mrp.production.search.view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='status']" position="after">
                <filter name='production_source' string='Production Source'
                        context="{'group_by' : 'production_source'}"/>
                <filter name='product_categ_id' string='Product Category' context="{'group_by' : 'product_categ_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="stock_view_move_tree_inherit" model="ir.ui.view">
        <field name="name">stocl.view.move.tree.inherit</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="quantity" position="after">
                <field name="bom_uom_qty" optional="hide"/>
                <field name="deviation_percentage" optional="hide"/>
                <field name="qty_difference" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="component_usage_analysis_action" model="ir.actions.act_window">
        <field name="name">Component Usage Analysis</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="view_id" ref="stock.view_move_tree"/>
        <field name="search_view_id" ref="stock.view_move_search"/>
        <field name="context">{'search_default_done': 1,
            'pivot_measures': ['quantity', '__count__'],
            }
        </field>
        <field name="domain">[('raw_material_production_id', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stock move found
            </p>
            <p>
                This menu gives you the full traceability of inventory
                operations on a specific product. You can filter on the product
                to see all the past or future movements for the product.
            </p>
        </field>
    </record>

    <menuitem id="menu_component_usage_analysis"
              name="Component Usage Analysis"
              parent="mrp.menu_mrp_reporting"
              action="component_usage_analysis_action"
              sequence="20"/>
</odoo>