<?xml version="1.0"?>
<odoo>
	<record id="view_purchase_order_agreement_form_view" model="ir.ui.view">
		<field name="name">Purchase Order</field>
		<field name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase.purchase_order_form"/>
		<field name="arch" type="xml">
			<xpath expr="//div[@name='button_box']" position="inside">
				<button name="recurring_purchase_order_agreement_button" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="recurring_purchase_order_agreement_count == 0">
					 <field name="recurring_purchase_order_agreement_count" string ="Recurring Purchase Order" widget="statinfo"/>
                </button>
			</xpath>
		</field>
	</record>
</odoo>
