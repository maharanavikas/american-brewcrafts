<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_quality_approval_wizard_form" model="ir.ui.view">
        <field name="name">quality.approval.wizard.view</field>
        <field name="model">quality.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Enter Remark">
                <group>
                    <field name="remark"/>
                </group>
                <footer>
                    <button string="Submit" name="apply_remark" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>