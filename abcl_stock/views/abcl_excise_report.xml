<?xml version="1.0" encoding="UTF-8"?>
        
<odoo>
  <template id="excise_report_delivery_order">
    <t t-call="web.internal_layout">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <div class="page" style="font-family: Calibri; font-size: 20px; line-height: 2; ">
          <div class="text-center">
            <h2 style="color: black;"><b><u>EXCISE VERIFICATION CERTIFICATE</u></b></h2>
          </div>
          <br/>
          <div style="font-weight: normal; word-spacing: 0.3em; line-height: 2;">
            <h5>Issued <t t-esc="int(doc.total_goods())"/> cases , <b><t t-foreach="doc.move_ids" t-as="product"> <t t-esc="int(product.quantity)"/> <t t-esc="product.product_uom.alias"/> of <t t-esc="product.product_id.name"/>,</t></b>
              to <t t-esc="doc.partner_id.name"/> under Export No: <b><t t-esc="doc.export_permit_id.display_name"/> Dt:- <t t-esc="doc.export_permit_date" t-options='{"widget": "date"}'/></b>
              issued by the Commissioner Of Prohibition &amp; Excise, Hyderabad of Telangana State and under import permit No: <b><t t-esc="doc.import_permit_id.display_name"/> Dt:- <t t-esc="doc.import_permit_date" t-options='{"widget": "date"}'/></b>
              issued by the <t t-esc="doc.partner_id.excise_approver_allias"/> and issued under Brewery Transport Permit No: <b><t t-esc="doc.transport_permit_no"/></b> dated: <b><t t-esc="doc.scheduled_date" t-options='{"widget": "date"}'/></b>
              by Brewery Officer, M/S Lilasons Alco Bev Private Limited, Mallepally(V), Kondapur (M), Sangareddy district of Telangana State.
            </h5>
            <h5>Vehicle No: <b><t t-esc="doc.vehicle_no"/></b></h5>
          </div>
          <br/>
          <br/>
          <br/>
          <br/>
          <br/>
          <div style="font-weight: normal; word-spacing: 0.3em; line-height: 2;">
            <h5>Received the above <t t-esc="int(doc.total_goods())"/> cases , <b><t t-foreach="doc.move_ids" t-as="product"> <t t-esc="int(product.quantity)"/> <t t-esc="product.product_uom.alias"/> of <t t-esc="product.product_id.name"/>,</t></b>
              from M/S Lilasons Alco Bev Private Limited, Mallepally(V), Kondapur (M), Sangareddy district of Telangana State PIN-502295 under Transport Permit No: <b><t t-esc="doc.transport_permit_no"/></b> Date:
              <b><t t-esc="doc.scheduled_date" t-options='{"widget": "date"}'/></b>
            </h5>
          </div>
          <br/>
          <div>
            <h5>Vehicle No: <b><t t-esc="doc.vehicle_no"/></b></h5>
          </div>
          <br/><br/>
          <div style="text-align: right;">
            <h5>Receiver Signature</h5>
            <h5>(with Office Stamp)</h5>
          </div>
        </div>
    </t>
  </template>

  <template id="excise_report">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
          <t t-call="abcl_stock.excise_report_delivery_order" t-lang="doc.partner_id.lang"/>
        </t>
    </t>
  </template>

  <record id="action_excise_report_delivery_order" model="ir.actions.report">
    <field name="name">Excise Report</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">abcl_stock.excise_report</field>
    <field name="report_file">abcl_stock.excise_report</field>
    <field name="print_report_name">'Excise Report - %s' % (object.name)</field>
  </record>
</odoo>
