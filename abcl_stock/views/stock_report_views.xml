<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_search_form_view_stock_report_inherit_groupby" model="ir.ui.view">
        <field name="name">product.product.search.stock.form.inherit.groupby</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_search_form_view_stock_report"/>
<!--        <field name="inherit_id" ref="product.product_search_form_view"/>-->
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter name="is_bom_component" string="Used in BOM" context="{'group_by': 'is_bom_component'}"/>
                <filter name="expiration_time" string="Expiration Date" context="{'group_by': 'expiration_time'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_stock_pivot" model="ir.ui.view">
        <field name="name">product.product.stock.pivot</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <pivot string="Stock Pivot">
                <field name="categ_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="view_product_stock_graph" model="ir.ui.view">
        <field name="name">product.product.stock.graph</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <graph string="Stock Graph" type="bar">
                <field name="categ_id" type="row"/>
            </graph>
        </field>
    </record>

    <record id="stock.action_product_stock_view" model="ir.actions.act_window">
        <field name="view_mode">list,form,pivot,graph</field>
    </record>
</odoo>
