<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="abcl_stock_warehouse_orderpoint_list_editable_view" model="ir.ui.view">
        <field name="name">abcl.stock.warehouse.orderpoint.list.editable.view</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_replenish']" position="attributes">
                <attribute name="groups">abcl_base.group_reordering_rules</attribute>
            </xpath>

            <xpath expr="//button[@name='action_replenish_auto']" position="attributes">
                <attribute name="groups">abcl_base.group_reordering_rules</attribute>
            </xpath>

            <xpath expr="//button[@name='%(stock.action_orderpoint_snooze)d']" position="attributes">
                <attribute name="groups">abcl_base.group_reordering_rules</attribute>
            </xpath>

        </field>
    </record>
</odoo>
