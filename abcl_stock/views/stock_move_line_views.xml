<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="abcl_view_move_line_list" model="ir.ui.view">
        <field name="name">abcl.view.move.line.list</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="manufacturing_date"/>
            </field>
        </field>
    </record>

    <record id="view_stock_move_line_list_inherit_view_button" model="ir.ui.view">
        <field name="name">stock.move.line.tree.inherit.view.button</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <button name="open_form_view"
                        string="View"
                        type="object"
                        icon="fa-eye"
                        class="btn-link"/>
            </xpath>
        </field>
    </record>

    <!-- Deactivate Jobs menu -->
        <record id="stock_picking_batch.menu_stock_jobs" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <!-- Deactivate Master Production Schedule menu -->
        <record id="mrp_mps.stock_mrp_mps_report_menu" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <!--     Deactivate Procurement Compute menu -->
        <record id="stock.menu_procurement_compute" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <!--    Rename Internal to Internal Transfers -->
        <record id="stock.int_picking" model="ir.ui.menu">
            <field name="name">Internal Transfers</field>
        </record>
</odoo>
