<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="abcl_quality_check_view_form" model="ir.ui.view">
        <field name="name">abcl.quality.check.view.form</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_form"/>
        <field name="arch" type="xml">
            <header>
                <button name="action_quality_approval_wizard" type="object" string="Approve" class="btn-primary" invisible="not sent_for_approval" groups="abcl_base.group_plant_manager"/>
                <button name="action_quality_reject_wizard" type="object" string="Reject" class="btn btn-danger" invisible="not sent_for_approval" groups="abcl_base.group_plant_manager"/>
            </header>
            <xpath expr="//button[@name='do_pass'][2]" position="attributes">
                <attribute name="groups">abcl_base.group_plant_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='do_fail'][2]" position="attributes">
                <attribute name="groups">abcl_base.group_plant_manager</attribute>
            </xpath>
            <field name="additional_note" position="after">
                <field name="plant_manager_comment"/>
            </field>
            <field name="operation_id" position="after">
                <field name="lot_id" readonly="1"/>
            </field>
            <field name="partner_id" position="after">
                <field name="is_check_failed" readonly="1"/>
                <field name="approver_id"/>
            </field>
            <field name="user_id" position="attributes">
                <attribute name="invisible">0</attribute>
            </field>
            <field name="approver_id" position="after">
                <field name="control_date"/>
            </field>
            <field name="picking_id" position="after">
                <field name="buyer_id" invisible="not picking_id"/>
            </field>
        </field>
    </record>

    <record id="abcl_quality_check_view_search" model="ir.ui.view">
        <field name="name">abcl.quality.check.view.search</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter name="control_date" string="Control Date" context="{'group_by': 'control_date'}"/>
            </xpath>
            <xpath expr="//filter[@name='failed']" position="after">
                <separator/>
                <filter name="mo_related_qc" string="Manufacturing Quality Checks" domain="[('point_id.picking_type_ids', '=', [11])]"/>
                <filter name="do_related_qc" string="Delivery Quality Checks" domain="[('point_id.picking_type_ids', '=', [1])]"/>
                <filter name="rc_related_qc" string="Receipt Quality Checks" domain='["&amp;", ("point_id.picking_type_ids", "in", [1]), ("picking_id.gate_entry_number", "!=", False)]'/>
            </xpath>
        </field>
    </record>

    <record id="quality_control.menu_quality_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('abcl_base.group_plant_manager'))]"/>
    </record>
</odoo>
