<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="abcl_stock_valuation_layer_list" model="ir.ui.view">
        <field name="name">abcl.stock.valuation.layer.list</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="categ_id" string="Product Category" optional="hide"/>
                <field name="consumed_qty" sum="Total Consumed Quantity" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>