<odoo>
    <record id="abcl_account_move_view_form" model="ir.ui.view">
        <field name="name">abcl.account.move.view.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']" position="after">
                <page string="Transport Info" invisible="move_type != 'out_invoice'">
                    <group>
                        <group>
                            <!--                            <field name="import_permit_no"/>-->
                            <field name="import_permit_id"/>
                            <field name="import_permit_date"/>
                            <!--                            <field name="export_permit_no"/>-->
                            <field name="export_permit_id"/>
                            <field name="export_permit_date"/>
                            <field name="excise_leaf_no"/>
                        </group>
                        <group>
                            <field name="transporter"/>
                            <field name="vehicle_type"/>
                            <field name="vehicle_detail_id"/>
                            <field name="vehicle_no"/>
                            <field name="transport_permit_no"/>
                            <field name="lr_gc_lwb_no"/>
                            <field name="lr_gc_lwb_date"/>
                            <field name="lr_no"/>
                            <field name="po_no"/>
                            <field name="po_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <!--            <xpath expr="//div[@name='journal_div']" position="after">-->
            <xpath expr="//page[@id='other_tab']//field[@name='delivery_date']" position='after'>
                <!--                <field name="po_no" invisible="move_type != 'out_invoice'"/>-->
                <!--                <field name="po_date" invisible="move_type != 'out_invoice'"/>-->
                <field name="abcl_invoice_sequence" invisible="move_type != 'out_invoice'"/>
            </xpath>
            <xpath expr="//div[@class='o_col' and field[@name='partner_id']]" position="after">
                <field name="stock_picking_id" options="{'no_create': True}" placeholder="Select a Delivery"/>
                <field name="related_sale_order_ids" widget="many2many_tags" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="abcl_account_move_line_form" model="ir.ui.view">
        <field name="name">abcl.account.move.line.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="qty_units" optional="show"/>
                <field name="qty_liters" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
